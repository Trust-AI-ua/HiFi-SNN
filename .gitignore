dataset/
.kaggle/
__pycache__/
*.pyc
*.pth
*.pt
.aws/
*.tex
# Ignore all per-run result artifacts; only keep the aggregate summary
# Early-exit prefix artifacts: 12.85 GB of per-timestep logits, regenerable
# with scripts/extract_prefix.py. Derived data, never source.
results/prefix_outputs/
*.npz

# Generated journal deliverables are outputs, not manuscript sources: the blanket
# *.tex rule above would silently drop them from version control.
!results/Journal_results/new_run_results/*.tex

# Conference tree: derived caches and the dataset symlink are never sources
conference/dataset
conference/results/cache/
!conference/paper/tables/*.tex
