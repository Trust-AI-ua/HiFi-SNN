dataset/
.kaggle/
__pycache__/
*.pyc
*.pth
*.pt
.aws/
*.tex
# Ignore all per-run result artifacts; only keep the aggregate summary
# Early-exit prefix artifacts: 12.85 GB of per-timestep logits, regenerable
# with scripts/extract_prefix.py. Derived data, never source.
results/prefix_outputs/
*.npz

# Generated journal deliverables are outputs, not manuscript sources: the blanket
# *.tex rule above would silently drop them from version control.
!results/Journal_results/new_run_results/*.tex

# Conference tree: derived caches and the dataset symlink are never sources
conference/dataset
conference/results/cache/
!conference/paper/*.tex
!conference/paper/tables/*.tex

# Generated LaTeX tables and section drafts written next to their CSVs; the
# blanket *.tex rule above would otherwise drop them.
!results/tables/*.tex

*.md
# Generated result tables and findings notes are deliverables, not scratch.
!results/tables/*.md
# Generated paper tables. The blanket *.tex rule above had hidden sixteen of them,
# including the IoT results table; the tracked ones had been force-added one by one.
!results/Journal_results/tables/*.tex
!results/superseded/*
# The manuscript handoff document. Excluded from the anonymized review export by
# scripts/make_anonymized_export.py (it names the author).
!HANDOFF_JOURNAL.md
!results/preregistration/*.md

# Manuscript figures and tables (scripts/make_manuscript_figures.py)
!Figures/*.tex
!Figures/README.md
!results/journal_partB/*.md
results/journal_partB/B8/*/artifacts/
